# Append to .env on the 32 GB / 8 vCPU server (NOT the current small server), then: docker compose up -d
# Backend: 6 worker processes x 12 database connections each = 72, under PG_MAX_CONNECTIONS
WEB_CONCURRENCY=6
DB_POOL_SIZE=12
# PostgreSQL memory and connections
PG_MAX_CONNECTIONS=150
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB
