FROM python:3.12-slim
WORKDIR /app
COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt email-validator
COPY backend/ backend/
COPY deploy/start_backend.sh /usr/local/bin/start_backend.sh
RUN mkdir -p backend/data && chmod +x /usr/local/bin/start_backend.sh
EXPOSE 8000
CMD ["start_backend.sh"]
